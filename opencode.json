{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git fetch*": "allow",
      "git remote -v": "allow",

      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr status": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch*": "allow",
      "gh auth status": "allow",

      "nix develop*": "allow",
      "nix build*": "allow",
      "nix flake check*": "allow",
      "nix flake lock*": "allow",

      "ruff *": "allow",
      "ty *": "allow",
      "uvicorn *": "allow",
      "pytest": "allow",
      "pytest *": "allow",
      "python3 *": "allow",
      "python *": "allow",
      "mkdir *": "allow",
      "ls": "allow",
      "ls *": "allow",

      "git push --force*": "ask",
      "git push -f *": "ask",
      "git push origin * --force*": "ask",
      "git push origin +*": "ask",
      "git branch -D *": "ask",
      "git branch -d *": "ask",
      "git branch --delete*": "ask"
    }
  }
}
